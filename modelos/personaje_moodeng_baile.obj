# moodeng de pie para bailar (chibi voxel, voxel de 0.04): el mismo esqueleto que miku_baile.obj.
# Y arriba, mira hacia -Z, origen en el piso. izq/der desde su punto de vista: izq = -X.
# Grupos (por nombre): brazo_/manga_/mano_ = brazo; muslo_/bota_/suela_ = pierna; torso*/corbata/falda*/cuello = cuerpo;
#   coleta_* = coleta; lo demas = cabeza.
# pivote hombro_der: 0.180 0.580 0.000
# pivote hombro_izq: -0.180 0.580 0.000
# pivote cadera_der: 0.040 0.320 0.000
# pivote cadera_izq: -0.040 0.320 0.000
# pivote cuello: 0.000 0.620 0.000
mtllib personaje_moodeng_baile.mtl

